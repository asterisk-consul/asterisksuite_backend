### ─────────────────────────────────────────────
### 🧾 Venta FA: Cliente RI + Prod GRAV_21 → IVA discriminado
### ─────────────────────────────────────────────
# @name saleFA_RI_21
POST {{baseUrl}}/documents/sales
Authorization: Bearer {{accessToken}}
Content-Type: application/json
x-tenant: dev

{
  "document_type_id": "{{docType_FA_VENTA}}",
  "party_id": "{{party_CLI_RI}}",
  "date": "2026-07-25",
  "currency_code": "ARS",
  "descrip": "Venta FA - Cliente RI - Prod IVA 21",
  "items": [
    { "product_id": "{{prod_IVA21}}", "quantity": 1, "unit_price": 2100 }
  ]
}


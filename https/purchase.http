### ─────────────────────────────────────────────
### 🧾 Compra FA: Proveedor RI + Prod IVA 21
### ─────────────────────────────────────────────
# @name purchaseFA_RI_21
POST {{baseUrl}}/documents/purchases-documents
Authorization: Bearer {{accessToken}}
Content-Type: application/json
x-tenant: dev

{
  "document_type_id": "{{docType_FA_COMPRA}}",
  "party_id": "{{party_PROV_RI}}",
  "date": "2026-07-25",
  "currency_code": "ARS",
  "descrip": "Compra FA - Proveedor RI - Prod IVA 21",
  "items": [
    { "product_id": "{{prod_IVA21}}", "quantity": 2, "unit_price": 2100 }
  ]
}


# ==============================
# 1. LOGIN + SETUP
# ==============================

### 🔐 Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
x-tenant: {{tenant}}

{
  "email": "admin@mail.com",
  "password": "123456"
}

###
@accessToken = {{login.response.body.accessToken}}

### 👤 Obtener companyId del usuario actual
# @name me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
x-tenant: {{tenant}}

###
@companyId = {{me.response.body.companies.0.id}}

### 📋 Verificar/crear company_tax_settings
# @name getSettings
GET {{baseUrl}}/company-tax-settings?company_id={{companyId}}
Authorization: Bearer {{accessToken}}
x-tenant: {{tenant}}

###
@settingsId = {{getSettings.response.body.id}}

# =====================================================
# 3. CONFIGURAR COMPANY → COMPLETE
# =====================================================

### ⚙️ Activar modo COMPLETE (IVA + IIBB)
PATCH {{baseUrl}}/company-tax-settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json
x-tenant: {{tenant}}

{
  "company_id": "{{companyId}}",
  "fiscal_mode": "COMPLETE",
  "prices_include_tax": false,
  "show_tax_breakdown": true
}

### ✅ Verificar configuración
GET {{baseUrl}}/company-tax-settings?company_id={{companyId}}
Authorization: Bearer {{accessToken}}
x-tenant: {{tenant}}

# =====================================================
# 4. TAX ENGINE PREVIEW — MODO COMPLETE
# =====================================================

### 🔍 Preview: Prod IVA 21 + Cliente RI → IVA 21%
# @name preview21
POST {{baseUrl}}/tax-engine/calculate-preview
Authorization: Bearer {{accessToken}}
Content-Type: application/json
x-tenant: {{tenant}}

{
  "issuerCompanyId": "{{companyId}}",
  "partnerId": "{{party_CLI_RI}}",
  "documentTypeId": "{{docType_FA_VENTA}}",
  "documentLetterType": "A",
  "currency": "ARS",
  "date": "2026-07-25",
  "operationType": "SALE",
  "items": [
    { "productId": "{{prod_IVA21}}", "quantity": 1, "unitPrice": 1000 }
  ]
}


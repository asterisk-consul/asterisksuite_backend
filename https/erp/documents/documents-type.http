@baseUrl = http://localhost:3000/api
###
# ==============================
# 🔐 LOGIN
# ==============================
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@mail.com",
  "password": "123456"
}

###  <-- este separador es clave

@accessToken = {{login.response.body.accessToken}}

@documentTypeId = 0453babd-adda-499f-9c8b-25bc7a52a762
@documentSequenceId = c92c58cf-bdbd-4cb1-9a3f-2ca87f8a281e

### Crear tipo de documento - Factura de Venta
POST {{baseUrl}}/documents-types
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "document_sequence_id": "{{documentSequenceId}}",
  "code": "VEN",
  "description": "Factura de Venta",
  "direction": 1,
  "affects_stock": false,
  "affects_accounting": true,
  "affects_tax_book": true,
  "active": true
}

###

### Obtener todos los tipos de documentos
GET {{baseUrl}}/documents-types
Authorization: Bearer {{accessToken}}

###

### Obtener tipo de documento por ID
GET {{baseUrl}}/documents-types/{{documentTypeId}}
Authorization: Bearer {{accessToken}}

###

### Actualizar tipo de documento
PATCH {{baseUrl}}/documents-types/{{documentTypeId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "description": "Factura de Venta Actualizada",
  "direction": 1,
  "affects_stock": false,
  "affects_accounting": true,
  "affects_tax_book": true,
  "active": true
}

###
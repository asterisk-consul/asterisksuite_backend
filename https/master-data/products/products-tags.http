@baseUrl = http://localhost:3000/api

### 🔐 LOGIN
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@mail.com",
  "password": "123456"
}

###

@accessToken = {{login.response.body.accessToken}}

@productId = REEMPLAZAR_PRODUCT_ID
@tagId = REEMPLAZAR_TAG_ID

### Asignar tag a producto
POST {{baseUrl}}/erp/product-tags/{{productId}}/{{tagId}}
Authorization: Bearer {{accessToken}}

###

### Obtener tags de un producto
GET {{baseUrl}}/erp/product-tags/{{productId}}
Authorization: Bearer {{accessToken}}

###

### Eliminar relación producto-tag
DELETE {{baseUrl}}/erp/product-tags/{{productId}}/{{tagId}}
Authorization: Bearer {{accessToken}}

###

@baseUrl = http://localhost:3000/api

###########################################################
# LOGIN
###########################################################

### LOGIN
# @name login

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@mail.com",
  "password": "123456"
}

###

@accessToken = {{login.response.body.accessToken}}

###########################################################
# IDS FIJOS
###########################################################

@kgUnitId = f39db553-925c-43bd-a088-dd86928a2e32
@meterUnitId = bbd1eb49-66e5-4126-813e-26f478ede723
@unitUnitId = 94fd5646-e316-4077-80a4-b59d1a51a7ff

@usdCurrencyId = 839c208c-744d-4321-a375-2a747c911fa2

###########################################################
# PRODUCTO 1 - CHAPA
###########################################################

### CREATE CHAPA
# @name createChapa

POST {{baseUrl}}/master-data/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Chapa SAE 1010",
  "sku": "CH-SAE1010",
  "product_type": "RAW_MATERIAL",
  "cost_source": "PURCHASE",
  "manages_stock": true,
  "active": true
}

###

@chapaProductId = 45059783-6a8b-4938-bb6a-020ecbbd867b

###########################################################
# VARIANTE CHAPA
###########################################################

### CREATE CHAPA VARIANT
# @name createChapaVariant

POST {{baseUrl}}/erp/product-variants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "product_id": "{{chapaProductId}}",
  "name": "Chapa 0.9mm",
  "sku": "CH-09",
  "thickness_mm": 0.9,
  "weight_kg": 7.065,
  "active": true
}

###

@chapaVariantId = 79796e1f-f7af-42ae-aebb-3f39abd0dc34

###########################################################
# COSTO CHAPA
###########################################################

### CREATE CHAPA COST

POST {{baseUrl}}/erp/variant-costs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "variant_id": "{{chapaVariantId}}",
  "currency_id": "{{usdCurrencyId}}",
  "source": "PURCHASE",
  "cost": 3200,
  "supplier": "Acindar"
}


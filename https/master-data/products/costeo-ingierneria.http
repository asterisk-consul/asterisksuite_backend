Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parent_product_id": "{{estructuraProductId}}",
  "child_product_id": "{{chapaProductId}}",
  "child_variant_id": "{{chapaVariantId}}",
  "quantity": 12,
  "length_mm": 1200,
  "width_mm": 600,
  "height_mm": 1,

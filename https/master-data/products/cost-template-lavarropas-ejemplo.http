###########################################################
# TEMPLATES — MATERIAL + LABOR FIJO
###########################################################

### Crear componente Material (FROM_BOM)
# @name createCompMaterial
POST {{baseUrl}}/cost-templates/components
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Material",
  "type": "MATERIAL",
  "value_type": "FROM_BOM",
  "order": 1
}

###

@materialComponentId = {{createCompMaterial.response.body.id}}

### Crear componente Labor fijo ensamblado lavarropas
# @name createCompLabor
POST {{baseUrl}}/cost-templates/components
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Mano de obra ensamblado",
  "type": "LABOR",
  "value_type": "FIXED_PER_UNIT",
  "value": 22000,
  "order": 2
}

###

@laborComponentId = {{createCompLabor.response.body.id}}

### Crear template Electrónica + Labor fijo
# @name createTemplate
POST {{baseUrl}}/cost-templates
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Electrónica + Labor fijo",
  "description": "Materiales desde ingeniería + mano de obra fija de ensamblado",
  "is_default": false,
  "components": [
    {
      "cost_component_id": "{{materialComponentId}}",
      "order": 1
    },
    {
      "cost_component_id": "{{laborComponentId}}",
      "order": 2
    }
  ]
}

###

@templateId = {{createTemplate.response.body.id}}

### Asignar template al lavarropas
POST {{baseUrl}}/cost-templates/{{templateId}}/products/{{lavarropasId}}
Authorization: Bearer {{accessToken}}

###########################################################
# CALCULAR COSTO FINAL
###########################################################

### Calcular — Engineering + Labor fijo
POST {{baseUrl}}/products/costing/calculate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "product_id": "{{lavarropasId}}",
  "currency_id": "{{usdCurrencyId}}",
  "save_snapshot": true
}

###########################################################
# VERIFICAR RESULTADOS
###########################################################

### Historial de costos
GET {{baseUrl}}/products/costing/{{lavarropasId}}/history
Authorization: Bearer {{accessToken}}

###

### Pareto consolidado (ver qué componente pesa más)
GET {{baseUrl}}/products/costing/{{lavarropasId}}/pareto?currencyId={{usdCurrencyId}}
Authorization: Bearer {{accessToken}}

###

### Árbol de ingeniería (sin costos, solo estructura)
GET {{baseUrl}}/erp/engineering/tree/{{lavarropasId}}
Authorization: Bearer {{accessToken}}
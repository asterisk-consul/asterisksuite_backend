@baseUrl = http://localhost:3000/api

###########################################################
# LOGIN
###########################################################

### LOGIN
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@mail.com",
  "password": "123456"
}

###

@accessToken = {{login.response.body.accessToken}}

###########################################################
# IDS FIJOS
###########################################################

@usdCurrencyId = 839c208c-744d-4321-a375-2a747c911fa2
@unitUnitId    = 94fd5646-e316-4077-80a4-b59d1a51a7ff

###########################################################
# MATERIA PRIMA 1 — CHAPA DE ACERO
###########################################################

### Crear chapa de acero
# @name createChapa
POST {{baseUrl}}/master-data/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Chapa de Acero Inoxidable",
  "sku": "MP-CHAPA-INOX",
  "product_type": "RAW_MATERIAL",
  "cost_source": "PURCHASE",
  "manages_stock": true,
  "active": true
}

###

@chapaId = {{createChapa.response.body.id}}

### Variante chapa 0.8mm
# @name createChapaVariant
POST {{baseUrl}}/erp/product-variants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "product_id": "{{chapaId}}",
  "name": "Chapa 0.8mm",
  "sku": "MP-CHAPA-08",
  "thickness_mm": 0.8,
  "weight_kg": 6.28,
  "active": true
}

###

@chapaVariantId = {{createChapaVariant.response.body.id}}

### Costo chapa
POST {{baseUrl}}/erp/variant-costs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "variant_id": "{{chapaVariantId}}",
  "currency_id": "{{usdCurrencyId}}",
  "source": "PURCHASE",
  "cost": 4200,
  "supplier": "Acindar"
}


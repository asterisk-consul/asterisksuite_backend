###########################################################
# SEMITERMINADO 1 — TAMBOR ENSAMBLADO
# (chapa x3 + motor)
###########################################################

### Crear tambor
# @name createTambor
POST {{baseUrl}}/master-data/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Tambor Ensamblado",
  "sku": "ST-TAMBOR",
  "product_type": "SEMI_FINISHED",
  "cost_source": "BOM",
  "is_composed": true,
  "manages_stock": true,
  "active": true
}

###

@tamborId = {{createTambor.response.body.id}}

### Componente: chapa → tambor (3 chapas con 8% desperdicio)
POST {{baseUrl}}/product-components
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parent_product_id": "{{tamborId}}",
  "child_product_id": "{{chapaId}}",
  "child_variant_id": "{{chapaVariantId}}",
  "quantity": 3,
  "waste_percentage": 8
}

###

### Componente: motor → tambor (1 motor)
POST {{baseUrl}}/product-components
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parent_product_id": "{{tamborId}}",
  "child_product_id": "{{motorId}}",
  "child_variant_id": "{{motorVariantId}}",
  "quantity": 1
}


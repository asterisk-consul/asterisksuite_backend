# Merge these optional variables into the backend .env.
# Never expose the OpenWA API key through NUXT_PUBLIC_* or frontend runtime config.
WHATSAPP_REPORTS_ENABLED=false
OPENWA_BASE_URL=https://whatsapp.asterisksuite.cloud
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Límite local para el PDF convertido a base64 antes de enviarlo a OpenWA.
# OpenWA admite hasta 50 MiB por archivo; el límite conservador reduce el pico de memoria.
OPENWA_MAX_REPORT_PDF_BYTES=15728640

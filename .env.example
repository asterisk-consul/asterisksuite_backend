# Puerto HTTP del backend
PORT=3008

# URL de la base de datos. Debe apuntar al puerto local que expone el túnel SSH
# (por defecto localhost:SSH_LOCAL_PORT)
DATABASE_URL=postgresql://usuario:password@localhost:5433/mi_base?schema=public

# Túnel SSH hacia el host donde vive PostgreSQL
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Usar una de las dos opciones:
#   - SSH_PRIVATE_KEY: contenido de la clave (con \n escapados)
#   - SSH_PRIVATE_KEY_PATH: ruta a un archivo montado
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PATH=
SSH_LOCAL_PORT=5433

# Orígenes permitidos para CORS (separados por coma). Si está vacío, permite todos.
CORS_ORIGINS=http://localhost:3008

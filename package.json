  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "frontend:install": "pnpm -C frontend install",
    "frontend:build": "pnpm -C frontend run build",
    "frontend:copy": "node scripts/copy-frontend.mjs",
    "build:all": "pnpm run build && pnpm run frontend:build && pnpm run frontend:copy",
    "start:all": "pnpm run frontend:build && pnpm run frontend:copy && pnpm run start",
    "start:all:prod": "pnpm run build:all && node dist/src/main.js",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",

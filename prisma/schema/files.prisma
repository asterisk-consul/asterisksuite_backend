model entity_photos {
  id          String    @id @default(uuid()) @db.Uuid
  entity_type String    @db.VarChar(30)
  entity_id   String    @db.Uuid
  file_id     String    @db.Uuid
  photo_type  String?   @db.VarChar(30)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @updatedAt @db.Timestamp(6)
  deleted_at  DateTime?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid
  files       files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_entity_photos")
  @@schema("tenant")
}

model files {
  id               String          @id @default(uuid()) @db.Uuid
  storage_provider String?         @db.VarChar(50)
  file_path        String
  public_url       String?
  file_name        String?         @db.VarChar(255)
  mime_type        String?         @db.VarChar(100)
  file_size        Int?
  uploaded_by      String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?
  created_by       String?         @db.Uuid
  updated_by       String?         @db.Uuid
  deleted_by       String?         @db.Uuid
  entity_photos    entity_photos[]

  @@schema("tenant")
}

model intake_records {
  id               String    @id @default(uuid()) @db.Uuid
  title            String?   @db.VarChar(150)
  notes            String?   @db.Text
  suggested_type   String?   @db.VarChar(30)
  status           String    @default("DRAFT") @db.VarChar(20)
  assigned_to      String?   @db.Uuid
  sent_at          DateTime?
  completed_at     DateTime?
  completed_by     String?   @db.Uuid
  target_type      String?   @db.VarChar(30)
  target_id        String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  deleted_by       String?   @db.Uuid

  @@index([assigned_to, status])
  @@index([created_by, status])
  @@schema("tenant")
}

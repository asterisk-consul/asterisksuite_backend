model sales_flow_settings {
  id                          String   @id @default(uuid()) @db.Uuid
  settings_key                String   @unique @default("default") @db.VarChar(30)
  accounting_basis            String   @default("INVOICE") @db.VarChar(30)
  payment_document_basis      String   @default("INVOICE") @db.VarChar(30)
  require_payment_for_delivery Boolean @default(false)
  delivery_payment_percentage Decimal  @default(100) @db.Decimal(5, 2)
  require_invoice_for_delivery Boolean @default(false)
  auto_create_delivery_note    Boolean @default(false)
  allow_partial_delivery       Boolean @default(true)
  active_from                  DateTime @default(now()) @db.Timestamp(6)
  created_at                   DateTime @default(now()) @db.Timestamp(6)
  updated_at                   DateTime @updatedAt @db.Timestamp(6)
  created_by                   String?  @db.Uuid
  updated_by                   String?  @db.Uuid

  @@schema("tenant")
}

model commercial_operations {
  id                           String    @id @default(uuid()) @db.Uuid
  root_document_id             String    @unique @db.Uuid
  party_id                     String?   @db.Uuid
  currency_code                String?   @db.VarChar(10)
  accounting_basis             String    @db.VarChar(30)
  payment_document_basis       String    @db.VarChar(30)
  require_payment_for_delivery Boolean
  delivery_payment_percentage  Decimal   @db.Decimal(5, 2)
  require_invoice_for_delivery Boolean
  auto_create_delivery_note    Boolean
  allow_partial_delivery       Boolean
  ordered_total                Decimal   @db.Decimal(15, 2)
  invoiced_total               Decimal   @default(0) @db.Decimal(15, 2)
  paid_total                   Decimal   @default(0) @db.Decimal(15, 2)
  delivery_status              String    @default("PENDING") @db.VarChar(30)
  released_at                  DateTime? @db.Timestamp(6)
  delivery_note_id             String?   @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamp(6)
  updated_at                   DateTime  @updatedAt @db.Timestamp(6)
  created_by                   String?   @db.Uuid
  updated_by                   String?   @db.Uuid

  root_document documents @relation("CommercialOperationRoot", fields: [root_document_id], references: [id], onDelete: Restrict)
  documents     documents[] @relation("CommercialOperationDocuments")
  party         business_parties? @relation(fields: [party_id], references: [id], onDelete: SetNull)

  @@index([delivery_status])
  @@index([party_id])
  @@schema("tenant")
}

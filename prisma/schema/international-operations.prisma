// ══════════════════════════════════════════════════════════
// OPERACIONES INTERNACIONALES — Enums
// ══════════════════════════════════════════════════════════

enum OperationType {
  IMPORT
  EXPORT
  OTHER

  @@schema("tenant")
}

enum TransportType {
  MARITIME
  AIR
  LAND
  MULTIMODAL
  OTHER

  @@schema("tenant")
}

enum OperationStatus {
  PLANNED
  IN_PREPARATION
  SHIPPED
  IN_TRANSIT
  ARRIVED
  CUSTOMS
  RELEASED
  DELIVERED
  CLOSED
  CANCELLED

  @@schema("tenant")
}

enum ContainerType {
  TWENTY_DV
  FORTY_DV
  FORTY_HC
  FORTY_FIVE_HC
  OTHER

  @@schema("tenant")
}

enum ContainerStatus {
  PREPARING
  LOADED
  SHIPPED
  IN_TRANSIT
  ARRIVED
  CUSTOMS
  RELEASED
  DELIVERED
  CLOSED

  @@schema("tenant")
}

enum ContainerEventType {
  LOADED_AT_ORIGIN
  DEPARTED_ORIGIN
  SHIPPED
  IN_TRANSIT
  ARRIVED_AT_PORT
  CUSTOMS
  RELEASED
  INLAND_TRANSPORT
  ARRIVED_AT_WAREHOUSE
  DELIVERED

  @@schema("tenant")
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP

  @@schema("tenant")
}

enum InternationalExpenseType {
  MERCHANDISE
  INTERNATIONAL_FREIGHT
  INSURANCE
  CUSTOMS_BROKER
  COMMERCIAL_AGENT
  PORT_EXPENSE
  STORAGE
  LOCAL_TRANSPORT
  CUSTOMS_DUTIES
  OTHER

  @@schema("tenant")
}

// ══════════════════════════════════════════════════════════
// OPERACIONES INTERNACIONALES — Models
// ══════════════════════════════════════════════════════════

model international_operations {
  id                       String                          @id @default(uuid()) @db.Uuid
  number                   String                          @unique @db.VarChar(20)
  name                     String?                         @db.VarChar(255)
  operation_type           OperationType                   @default(IMPORT)
  transport_type           TransportType                   @default(MARITIME)
  status                   OperationStatus                 @default(PLANNED)
  primary_supplier_id      String?                         @db.Uuid
  origin_country           String?                         @db.VarChar(100)
  origin_location          String?                         @db.VarChar(255)
  origin_location_id       String?                         @db.Uuid
  destination_country      String?                         @db.VarChar(100)
  destination_location     String?                         @db.VarChar(255)
  destination_location_id  String?                         @db.Uuid
  estimated_departure_date DateTime?                       @db.Date
  actual_departure_date    DateTime?                       @db.Date
  estimated_arrival_date   DateTime?                       @db.Date
  actual_arrival_date      DateTime?                       @db.Date
  currency_code            String?                         @db.VarChar(10)
  incoterm                 Incoterm?
  responsible_user_id      String?                         @db.Uuid
  notes                    String?                         @db.Text
  created_at               DateTime                        @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                       @updatedAt @db.Timestamp(6)
  deleted_at               DateTime?
  created_by               String?                         @db.Uuid
  updated_by               String?                         @db.Uuid
  deleted_by               String?                         @db.Uuid

  primary_supplier     business_parties?                   @relation(fields: [primary_supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  origin_loc           locations?                          @relation("io_origin_location", fields: [origin_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_loc      locations?                          @relation("io_destination_location", fields: [destination_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  containers           international_containers[]
  operation_documents  international_operation_documents[]
  operation_payments   international_operation_payments[]
  purchase_orders      orden_compra_documents[]

  @@index([status], map: "idx_io_status")
  @@index([primary_supplier_id], map: "idx_io_supplier")
  @@index([estimated_arrival_date], map: "idx_io_eta")
  @@schema("tenant")
}

model international_containers {
  id                       String                   @id @default(uuid()) @db.Uuid
  operation_id             String                   @db.Uuid
  container_number         String                   @db.VarChar(50)
  container_type           ContainerType            @default(TWENTY_DV)
  seal_number              String?                  @db.VarChar(50)
  booking_number           String?                  @db.VarChar(50)
  bill_of_lading           String?                  @db.VarChar(50)
  vessel_name              String?                  @db.VarChar(100)
  voyage_number            String?                  @db.VarChar(50)
  origin_port              String?                  @db.VarChar(100)
  origin_port_id           String?                  @db.Uuid
  destination_port         String?                  @db.VarChar(100)
  destination_port_id      String?                  @db.Uuid
  estimated_departure_date DateTime?                @db.Date
  actual_departure_date    DateTime?                @db.Date
  estimated_arrival_date   DateTime?                @db.Date
  actual_arrival_date      DateTime?                @db.Date
  status                   ContainerStatus          @default(PREPARING)
  weight                   Decimal?                 @db.Decimal(12, 3)
  volume                   Decimal?                 @db.Decimal(12, 3)
  notes                    String?                  @db.Text
  created_at               DateTime                 @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @updatedAt @db.Timestamp(6)
  deleted_at               DateTime?
  created_by               String?                  @db.Uuid
  updated_by               String?                  @db.Uuid
  deleted_by               String?                  @db.Uuid

  operation international_operations    @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  origin_port_loc      locations?                      @relation("ic_origin_port", fields: [origin_port_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_port_loc locations?                      @relation("ic_destination_port", fields: [destination_port_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events               container_events[]
  container_documents  international_operation_documents[]

  @@index([operation_id], map: "idx_ic_operation")
  @@schema("tenant")
}

model container_events {
  id          String               @id @default(uuid()) @db.Uuid
  container_id String              @db.Uuid
  event_type  ContainerEventType
  event_date  DateTime             @db.Date
  location_text String?            @db.VarChar(255)
  description String?              @db.Text
  estimated   Boolean              @default(false)
  created_by  String?              @db.Uuid
  created_at  DateTime             @default(now()) @db.Timestamp(6)

  container international_containers @relation(fields: [container_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([container_id], map: "idx_ce_container")
  @@schema("tenant")
}

model international_operation_documents {
  operation_id                  String                      @db.Uuid
  document_id                   String                      @db.Uuid
  expense_type                  InternationalExpenseType    @default(MERCHANDISE)
  custom_expense_description    String?                     @db.VarChar(255)
  container_id                  String?                     @db.Uuid
  exchange_rate                 Decimal?                    @db.Decimal(18, 6)
  created_at                    DateTime                    @default(now()) @db.Timestamp(6)

  operation international_operations    @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document  documents                 @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  container international_containers? @relation(fields: [container_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@id([operation_id, document_id])
  @@index([container_id], map: "idx_iod_container")
  @@schema("tenant")
}

model international_operation_payments {
  operation_id String   @db.Uuid
  payment_id   String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp(6)

  operation international_operations @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment   payments                 @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([operation_id, payment_id])
  @@schema("tenant")
}

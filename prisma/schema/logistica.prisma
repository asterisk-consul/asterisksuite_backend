model transfer_rates {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(100)
  rate_type      String           @db.VarChar(20)
  description    String?
  active         Boolean?         @default(true)
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @updatedAt @db.Timestamp(6)
  deleted_at     DateTime?
  created_by     String?          @db.Uuid
  updated_by     String?          @db.Uuid
  deleted_by     String?          @db.Uuid
  dispatch_rates dispatch_rates[]
  products       products[]

  @@schema("tenant")
}

model dispatch_rates {
  id               String            @id @default(uuid()) @db.Uuid
  dispatch_id      String            @db.Uuid
  rate_id          String            @db.Uuid
  value            Decimal           @db.Decimal(12, 2)
  currency_code    String?           @db.VarChar(10)
  exchange_rate    Decimal?          @db.Decimal(18, 6)
  rate_type        CurrencyRateType?
  converted_amount Decimal?          @db.Decimal(18, 2)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?
  created_by       String?           @db.Uuid
  updated_by       String?           @db.Uuid
  deleted_by       String?           @db.Uuid
  dispatch_orders  dispatch_orders   @relation(fields: [dispatch_id], references: [id], onDelete: Cascade)
  transfer_rates   transfer_rates    @relation(fields: [rate_id], references: [id])

  @@schema("tenant")
}

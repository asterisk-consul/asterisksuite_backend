model companies {
  id                     String                            @id @default(uuid()) @db.Uuid
  name                   String                            @db.VarChar(255)
  tax_id                 String?                           @db.VarChar(50)
  vat_condition          String?                           @db.VarChar(30) // RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO
  address                String?                           @db.VarChar(500)
  email                  String?                           @db.VarChar(255)
  phone                  String?                           @db.VarChar(30)
  subdomain              String?                           @unique @db.VarChar(100)
  schema_name            String?                           @unique @db.VarChar(100)
  created_at             DateTime                          @default(now()) @db.Timestamp(6)
  updated_at             DateTime                          @updatedAt @db.Timestamp(6)
  deleted_at             DateTime?
  created_by             String?                           @db.Uuid
  updated_by             String?                           @db.Uuid
  deleted_by             String?                           @db.Uuid
  companyUsers           company_users[]
  tablePreferences       user_table_preferences[]
  arcaSettings           company_arca_settings?
  whatsappReportSettings company_whatsapp_report_settings?
  whatsappReportRuns     company_whatsapp_report_runs[]
  mcpGrants              mcp_oauth_grants[]
  platformAdminScopes    platform_admin_company_scopes[]
  subscription           company_subscriptions?
  moduleOverrides        company_module_overrides[]

  @@schema("public")
}

// Licencias comerciales globales por empresa. Mantener separadas de
// tenant.system_modules, que representa los módulos internos del ERP.
model platform_modules {
  code         String    @id @db.VarChar(50)
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  icon         String?   @db.VarChar(100)
  sort_order   Int       @default(0)
  is_core      Boolean   @default(false)
  active       Boolean   @default(true)
  dependencies Json      @default("[]")
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @updatedAt @db.Timestamp(6)

  planModules subscription_plan_modules[]
  overrides   company_module_overrides[]

  @@schema("public")
}

model subscription_plans {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  is_legacy   Boolean   @default(false)
  active      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @updatedAt @db.Timestamp(6)

  modules       subscription_plan_modules[]
  subscriptions company_subscriptions[]

  @@schema("public")
}

model subscription_plan_modules {
  plan_id     String  @db.Uuid
  module_code String  @db.VarChar(50)
  enabled     Boolean @default(true)
  limits      Json    @default("{}")

  plan   subscription_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  module platform_modules   @relation(fields: [module_code], references: [code], onDelete: Cascade)

  @@id([plan_id, module_code])
  @@schema("public")
}

model company_subscriptions {
  id            String             @id @default(uuid()) @db.Uuid
  company_id    String             @unique @db.Uuid
  plan_id       String             @db.Uuid
  status        SubscriptionStatus @default(ACTIVE)
  starts_at     DateTime           @default(now()) @db.Timestamp(6)
  trial_ends_at DateTime?          @db.Timestamp(6)
  renews_at     DateTime?          @db.Timestamp(6)
  cancelled_at  DateTime?          @db.Timestamp(6)
  created_at    DateTime           @default(now()) @db.Timestamp(6)
  updated_at    DateTime?          @updatedAt @db.Timestamp(6)

  company companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan    subscription_plans @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@index([plan_id, status])
  @@schema("public")
}

model company_module_overrides {
  id          String              @id @default(uuid()) @db.Uuid
  company_id  String              @db.Uuid
  module_code String              @db.VarChar(50)
  state       ModuleOverrideState
  reason      String?             @db.VarChar(500)
  expires_at  DateTime?           @db.Timestamp(6)
  created_at  DateTime            @default(now()) @db.Timestamp(6)
  updated_at  DateTime?           @updatedAt @db.Timestamp(6)

  company companies        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  module  platform_modules @relation(fields: [module_code], references: [code], onDelete: Cascade)

  @@unique([company_id, module_code])
  @@index([expires_at])
  @@schema("public")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@schema("public")
}

enum ModuleOverrideState {
  ENABLED
  READ_ONLY
  DISABLED

  @@schema("public")
}

model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  revoked    Boolean   @default(false)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "idx_refresh_tokens_token_hash")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([revoked_at], map: "idx_refresh_tokens_revoked_at")
  @@schema("public")
}

model audit_logs_public {
  id         String      @id @default(uuid()) @db.Uuid
  table_name String      @db.VarChar(100)
  record_id  String      @db.VarChar(500)
  old_data   Json?
  new_data   Json?
  changed_by String?     @db.Uuid
  changed_at DateTime    @default(now()) @db.Timestamp(6)
  ip_address String?     @db.VarChar(50)
  request_id String?     @db.VarChar(100)
  action     AuditAction

  @@map("audit_logs")
  @@schema("public")
}

model users {
  id                      String                       @id @default(uuid()) @db.Uuid
  name                    String                       @db.VarChar(255)
  email                   String                       @unique @db.VarChar(255)
  password_hash           String?
  role                    PlatformRole?
  active                  Boolean?                     @default(true)
  employee_id             String?                      @db.Uuid
  partner_id              String?                      @db.Uuid
  created_at              DateTime                     @default(now()) @db.Timestamp(6)
  updated_at              DateTime                     @updatedAt @db.Timestamp(6)
  deleted_at              DateTime?
  created_by              String?                      @db.Uuid
  updated_by              String?                      @db.Uuid
  deleted_by              String?                      @db.Uuid
  refreshTokens           refresh_tokens[]
  companyUsers            company_users[]
  tablePreferences        user_table_preferences[]
  mcpGrants               mcp_oauth_grants[]
  platformAdminAssignment platform_admin_assignments?  @relation("platform_admin_user")
  platformAdminGrants     platform_admin_assignments[] @relation("platform_admin_granted_by")
  platformAdminUpdates    platform_admin_assignments[] @relation("platform_admin_updated_by")

  @@schema("public")
}

model company_users {
  company_id String      @db.Uuid
  user_id    String      @db.Uuid
  role       CompanyRole
  company    companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@schema("public")
}

// Rol global de administración de plataforma y alcance explícito por empresa.
// Se mantiene separado de company_users para no dar acceso al ERP tenant.
model platform_admin_assignments {
  user_id       String        @id @db.Uuid
  previous_role PlatformRole?
  granted_by    String?       @db.Uuid
  updated_by    String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @updatedAt @db.Timestamp(6)

  user      users                           @relation("platform_admin_user", fields: [user_id], references: [id], onDelete: Cascade)
  grantor   users?                          @relation("platform_admin_granted_by", fields: [granted_by], references: [id], onDelete: SetNull)
  updater   users?                          @relation("platform_admin_updated_by", fields: [updated_by], references: [id], onDelete: SetNull)
  companies platform_admin_company_scopes[]

  @@schema("public")
}

model platform_admin_company_scopes {
  user_id    String   @db.Uuid
  company_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)

  assignment platform_admin_assignments @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  company    companies                  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([user_id, company_id])
  @@index([company_id, user_id])
  @@schema("public")
}

enum CompanyRole {
  OWNER
  ADMIN
  USER

  @@schema("public")
}

enum PlatformRole {
  PLATFORM_OWNER
  SUPPORT
  PLATFORM_ADMIN
  PLATFORM_USER

  @@schema("public")
}

model company_tax_settings {
  id                 String     @id @default(uuid()) @db.Uuid
  company_id         String     @unique @db.Uuid
  fiscal_mode        FiscalMode @default(SIMPLE)
  prices_include_tax Boolean    @default(true)
  show_tax_breakdown Boolean    @default(false)
  country            String     @default("AR") @db.VarChar(3)
  created_at         DateTime   @default(now()) @db.Timestamp(6)
  updated_at         DateTime?  @updatedAt @db.Timestamp(6)

  @@schema("public")
}

model company_arca_settings {
  company_id               String    @id @db.Uuid
  issuer_cuit              String    @db.VarChar(11)
  environment              String    @default("HOMOLOGATION") @db.VarChar(20)
  point_of_sale            Int?
  credentials_ciphertext   String    @db.Text
  credentials_iv           String    @db.VarChar(32)
  credentials_auth_tag     String    @db.VarChar(32)
  access_ticket_ciphertext String?   @db.Text
  access_ticket_iv         String?   @db.VarChar(32)
  access_ticket_auth_tag   String?   @db.VarChar(32)
  access_ticket_expires_at DateTime? @db.Timestamp(6)
  certificate_subject      String?   @db.Text
  certificate_serial       String?   @db.VarChar(100)
  certificate_valid_to     DateTime? @db.Timestamp(6)
  available_point_sales    Json?
  last_test_status         String    @default("NOT_TESTED") @db.VarChar(20)
  last_test_message        String?   @db.Text
  last_tested_at           DateTime? @db.Timestamp(6)
  configured_by            String?   @db.Uuid
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @updatedAt @db.Timestamp(6)
  company                  companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

model user_table_preferences {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  company_id        String    @db.Uuid
  table_key         String    @db.VarChar(200)
  column_order      Json      @default("[]")
  column_visibility Json      @default("{}")
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  user              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company           companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id, table_key], map: "user_table_preferences_user_company_table_key")
  @@index([company_id, user_id], map: "user_table_preferences_company_user_idx")
  @@schema("public")
}

model company_whatsapp_report_settings {
  company_id            String    @id @db.Uuid
  enabled               Boolean   @default(false)
  selected_company_ids  Json      @default("[]")
  consolidated_enabled  Boolean   @default(true)
  consolidated_group_id String?   @db.VarChar(255)
  inventory_enabled     Boolean   @default(true)
  inventory_group_id    String?   @db.VarChar(255)
  configured_by         String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  company               companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([enabled], map: "company_whatsapp_report_settings_enabled_idx")
  @@schema("public")
}

model company_whatsapp_report_runs {
  id            String    @id @default(uuid()) @db.Uuid
  company_id    String    @db.Uuid
  report_type   String    @db.VarChar(32)
  period_start  DateTime  @db.Date
  period_end    DateTime  @db.Date
  status        String    @default("PENDING") @db.VarChar(20)
  attempt_count Int       @default(0)
  message_id    String?   @db.VarChar(255)
  last_error    String?   @db.Text
  started_at    DateTime? @db.Timestamp(6)
  sent_at       DateTime? @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  company       companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, report_type, period_start, period_end], map: "company_whatsapp_report_runs_period_key")
  @@index([company_id, created_at(sort: Desc)], map: "company_whatsapp_report_runs_company_created_idx")
  @@schema("public")
}

model mcp_oauth_clients {
  client_id   String   @id @db.VarChar(255)
  client_info Json
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@schema("public")
}

model mcp_oauth_pending_authorizations {
  id               String    @id @default(uuid()) @db.Uuid
  client_id        String    @db.VarChar(255)
  redirect_uri     String    @db.Text
  requested_state  String?   @db.Text
  code_challenge   String    @db.VarChar(255)
  requested_scopes String[]  @default([])
  resource         String?   @db.Text
  expires_at       DateTime  @db.Timestamp(6)
  consumed_at      DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  @@index([expires_at], map: "mcp_oauth_pending_expiry_idx")
  @@schema("public")
}

model mcp_oauth_grants {
  id         String    @id @default(uuid()) @db.Uuid
  client_id  String    @db.VarChar(255)
  user_id    String    @db.Uuid
  company_id String    @db.Uuid
  scopes     String[]  @default([])
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, company_id, revoked_at], map: "mcp_oauth_grants_user_company_idx")
  @@index([client_id], map: "mcp_oauth_grants_client_idx")
  @@schema("public")
}

model mcp_oauth_codes {
  code_hash      String    @id @db.VarChar(64)
  grant_id       String    @db.Uuid
  client_id      String    @db.VarChar(255)
  redirect_uri   String    @db.Text
  code_challenge String    @db.VarChar(255)
  scopes         String[]  @default([])
  resource       String?   @db.Text
  expires_at     DateTime  @db.Timestamp(6)
  consumed_at    DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([expires_at], map: "mcp_oauth_codes_expiry_idx")
  @@index([grant_id], map: "mcp_oauth_codes_grant_idx")
  @@schema("public")
}

model mcp_oauth_refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  grant_id   String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  scopes     String[]  @default([])
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([grant_id, revoked_at], map: "mcp_oauth_refresh_grant_idx")
  @@index([expires_at], map: "mcp_oauth_refresh_expiry_idx")
  @@schema("public")
}

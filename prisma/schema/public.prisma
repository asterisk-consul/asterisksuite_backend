model companies {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(255)
  tax_id       String?         @db.VarChar(50)
  phone        String?         @db.VarChar(30)
  subdomain    String?         @unique @db.VarChar(100)
  schema_name  String?         @unique @db.VarChar(100)
  created_at   DateTime        @default(now()) @db.Timestamp(6)
  updated_at   DateTime        @updatedAt @db.Timestamp(6)
  deleted_at   DateTime?
  created_by   String?         @db.Uuid
  updated_by   String?         @db.Uuid
  deleted_by   String?         @db.Uuid
  companyUsers company_users[]

  @@schema("public")
}


model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  revoked    Boolean   @default(false)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "idx_refresh_tokens_token_hash")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([revoked_at], map: "idx_refresh_tokens_revoked_at")
  @@schema("public")
}

model audit_logs_public {
  id         String      @id @default(uuid()) @db.Uuid
  table_name String      @db.VarChar(100)
  record_id  String      @db.VarChar(500)
  old_data   Json?
  new_data   Json?
  changed_by String?     @db.Uuid
  changed_at DateTime    @default(now()) @db.Timestamp(6)
  ip_address String?     @db.VarChar(50)
  request_id String?     @db.VarChar(100)
  action     AuditAction

  @@map("audit_logs")
  @@schema("public")
}


model users {
  id                        String                      @id @default(uuid()) @db.Uuid
  name                      String                      @db.VarChar(255)
  email                     String                      @unique @db.VarChar(255)
  password_hash             String?
  role                      PlatformRole?
  active                    Boolean?                    @default(true)
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @updatedAt @db.Timestamp(6)
  deleted_at                DateTime?
  created_by                String?                     @db.Uuid
  updated_by                String?                     @db.Uuid
  deleted_by                String?                     @db.Uuid
  auditLogs                 audit_logs[]
  cargo_transfers           cargo_transfers[]
  delivery_notes            delivery_notes[]
  dispatch_orders           dispatch_orders[]
  files                     files[]
  pallets                   pallets[]
  picking_orders            picking_orders[]
  refreshTokens             refresh_tokens[]
  trip_temperature_logs     trip_temperature_logs[]
  trips                     trips[]
  vehicle_combinations      vehicle_combinations[]
  warehouse_stock_movements warehouse_stock_movements[]
  companyUsers              company_users[]
   @@schema("public")
}

model company_users {
  company_id String @db.Uuid
  user_id    String @db.Uuid
  role CompanyRole
  company companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@id([company_id, user_id])
   @@schema("public")
}

enum CompanyRole {
  OWNER
  ADMIN
  USER
   @@schema("public")
}


enum PlatformRole {
  PLATFORM_OWNER
  SUPPORT
  PLATFORM_ADMIN
   @@schema("public")
}
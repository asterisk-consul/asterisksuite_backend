model companies {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @db.VarChar(255)
  tax_id        String?         @db.VarChar(50)
  vat_condition String?         @db.VarChar(30) // RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO
  address       String?         @db.VarChar(500)
  email         String?         @db.VarChar(255)
  phone         String?         @db.VarChar(30)
  subdomain     String?         @unique @db.VarChar(100)
  schema_name   String?         @unique @db.VarChar(100)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @updatedAt @db.Timestamp(6)
  deleted_at    DateTime?
  created_by    String?         @db.Uuid
  updated_by    String?         @db.Uuid
  deleted_by    String?         @db.Uuid
  companyUsers  company_users[]
  tablePreferences user_table_preferences[]
  whatsappReportSettings company_whatsapp_report_settings?
  whatsappReportRuns     company_whatsapp_report_runs[]
  mcpGrants              mcp_oauth_grants[]

  @@schema("public")
}

model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  revoked    Boolean   @default(false)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "idx_refresh_tokens_token_hash")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([revoked_at], map: "idx_refresh_tokens_revoked_at")
  @@schema("public")
}

model audit_logs_public {
  id         String      @id @default(uuid()) @db.Uuid
  table_name String      @db.VarChar(100)
  record_id  String      @db.VarChar(500)
  old_data   Json?
  new_data   Json?
  changed_by String?     @db.Uuid
  changed_at DateTime    @default(now()) @db.Timestamp(6)
  ip_address String?     @db.VarChar(50)
  request_id String?     @db.VarChar(100)
  action     AuditAction

  @@map("audit_logs")
  @@schema("public")
}

model users {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(255)
  email         String           @unique @db.VarChar(255)
  password_hash String?
  role          PlatformRole?
  active        Boolean?         @default(true)
  employee_id   String?          @db.Uuid
  partner_id    String?          @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamp(6)
  updated_at    DateTime         @updatedAt @db.Timestamp(6)
  deleted_at    DateTime?
  created_by    String?          @db.Uuid
  updated_by    String?          @db.Uuid
  deleted_by    String?          @db.Uuid
  refreshTokens refresh_tokens[]
  companyUsers     company_users[]
  tablePreferences user_table_preferences[]
  mcpGrants       mcp_oauth_grants[]

  @@schema("public")
}

model company_users {
  company_id String      @db.Uuid
  user_id    String      @db.Uuid
  role       CompanyRole
  company    companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@schema("public")
}

enum CompanyRole {
  OWNER
  ADMIN
  USER

  @@schema("public")
}

enum PlatformRole {
  PLATFORM_OWNER
  SUPPORT
  PLATFORM_ADMIN
  PLATFORM_USER

  @@schema("public")
}

model company_tax_settings {
  id                 String     @id @default(uuid()) @db.Uuid
  company_id         String     @unique @db.Uuid
  fiscal_mode        FiscalMode @default(SIMPLE)
  prices_include_tax Boolean    @default(true)
  show_tax_breakdown Boolean    @default(false)
  country            String     @default("AR") @db.VarChar(3)
  created_at         DateTime   @default(now()) @db.Timestamp(6)
  updated_at         DateTime?  @updatedAt @db.Timestamp(6)

  @@schema("public")
}

model user_table_preferences {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  company_id         String   @db.Uuid
  table_key          String   @db.VarChar(200)
  column_order       Json     @default("[]")
  column_visibility  Json     @default("{}")
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user               users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company            companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id, table_key], map: "user_table_preferences_user_company_table_key")
  @@index([company_id, user_id], map: "user_table_preferences_company_user_idx")
  @@schema("public")
}

model company_whatsapp_report_settings {
  company_id            String    @id @db.Uuid
  enabled               Boolean   @default(false)
  selected_company_ids  Json      @default("[]")
  consolidated_enabled  Boolean   @default(true)
  consolidated_group_id String?   @db.VarChar(255)
  inventory_enabled     Boolean   @default(true)
  inventory_group_id    String?   @db.VarChar(255)
  configured_by         String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  company               companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([enabled], map: "company_whatsapp_report_settings_enabled_idx")
  @@schema("public")
}

model company_whatsapp_report_runs {
  id            String    @id @default(uuid()) @db.Uuid
  company_id    String    @db.Uuid
  report_type   String    @db.VarChar(32)
  period_start  DateTime  @db.Date
  period_end    DateTime  @db.Date
  status        String    @default("PENDING") @db.VarChar(20)
  attempt_count Int       @default(0)
  message_id    String?   @db.VarChar(255)
  last_error    String?   @db.Text
  started_at    DateTime? @db.Timestamp(6)
  sent_at       DateTime? @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  company       companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, report_type, period_start, period_end], map: "company_whatsapp_report_runs_period_key")
  @@index([company_id, created_at(sort: Desc)], map: "company_whatsapp_report_runs_company_created_idx")
  @@schema("public")
}

model mcp_oauth_clients {
  client_id   String   @id @db.VarChar(255)
  client_info Json
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@schema("public")
}

model mcp_oauth_pending_authorizations {
  id               String    @id @default(uuid()) @db.Uuid
  client_id        String    @db.VarChar(255)
  redirect_uri     String    @db.Text
  requested_state  String?   @db.Text
  code_challenge   String    @db.VarChar(255)
  requested_scopes String[]  @default([])
  resource         String?   @db.Text
  expires_at       DateTime  @db.Timestamp(6)
  consumed_at      DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  @@index([expires_at], map: "mcp_oauth_pending_expiry_idx")
  @@schema("public")
}

model mcp_oauth_grants {
  id         String    @id @default(uuid()) @db.Uuid
  client_id  String    @db.VarChar(255)
  user_id    String    @db.Uuid
  company_id String    @db.Uuid
  scopes     String[]  @default([])
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, company_id, revoked_at], map: "mcp_oauth_grants_user_company_idx")
  @@index([client_id], map: "mcp_oauth_grants_client_idx")
  @@schema("public")
}

model mcp_oauth_codes {
  code_hash      String    @id @db.VarChar(64)
  grant_id       String    @db.Uuid
  client_id      String    @db.VarChar(255)
  redirect_uri   String    @db.Text
  code_challenge String    @db.VarChar(255)
  scopes         String[]  @default([])
  resource       String?   @db.Text
  expires_at     DateTime  @db.Timestamp(6)
  consumed_at    DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([expires_at], map: "mcp_oauth_codes_expiry_idx")
  @@index([grant_id], map: "mcp_oauth_codes_grant_idx")
  @@schema("public")
}

model mcp_oauth_refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  grant_id   String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  scopes     String[]  @default([])
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([grant_id, revoked_at], map: "mcp_oauth_refresh_grant_idx")
  @@index([expires_at], map: "mcp_oauth_refresh_expiry_idx")
  @@schema("public")
}

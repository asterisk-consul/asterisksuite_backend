model warehouse_stock {
  id                String     @id @default(uuid()) @db.Uuid
  warehouse_id      String     @db.Uuid
  product_id        String     @db.Uuid
  quantity          Decimal    @default(0) @db.Decimal(12, 3)
  reserved_quantity Decimal    @default(0) @db.Decimal(12, 3)
  created_at        DateTime   @default(now()) @db.Timestamp(6)
  updated_at        DateTime?  @updatedAt @db.Timestamp(6)
  deleted_at        DateTime?
  created_by        String?    @db.Uuid
  updated_by        String?    @db.Uuid
  deleted_by        String?    @db.Uuid
  products          products   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses        warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([warehouse_id, product_id])
  @@schema("tenant")
}

model stock_reservations {
  id                String    @id @default(uuid()) @db.Uuid
  warehouse_id      String    @db.Uuid
  product_id        String    @db.Uuid
  quantity_reserved Decimal   @db.Decimal(12, 3)
  quantity_consumed Decimal   @default(0) @db.Decimal(12, 3)
  quantity_released Decimal   @default(0) @db.Decimal(12, 3)
  status            String    @default("ACTIVE") @db.VarChar(30)
  reservation_type  String    @default("SALES_ORDER") @db.VarChar(30)
  source_type       String?   @db.VarChar(30)
  source_id         String?   @db.Uuid
  source_item_id    String?   @db.Uuid
  party_id          String?   @db.Uuid
  reason            String?   @db.Text
  expires_at        DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @updatedAt @db.Timestamp(6)
  deleted_at        DateTime?
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid

  warehouse   warehouses                      @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  product     products                        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  allocations stock_reservation_allocations[]

  @@index([warehouse_id, product_id, status])
  @@index([source_type, source_id])
  @@index([source_item_id])
  @@index([expires_at, status])
  @@schema("tenant")
}

model stock_reservation_allocations {
  id             String             @id @default(uuid()) @db.Uuid
  reservation_id String             @db.Uuid
  document_id    String             @db.Uuid
  quantity       Decimal            @db.Decimal(12, 3)
  status         String             @default("CONSUMED") @db.VarChar(20)
  created_at     DateTime           @default(now()) @db.Timestamp(6)
  reversed_at    DateTime?          @db.Timestamp(6)
  created_by     String?            @db.Uuid
  reservation    stock_reservations @relation(fields: [reservation_id], references: [id], onDelete: Restrict)

  @@index([document_id, status])
  @@index([reservation_id])
  @@schema("tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model warehouse_stock_movements {
  id             String     @id @default(uuid()) @db.Uuid
  warehouse_id   String     @db.Uuid
  product_id     String     @db.Uuid
  movement_type  String     @db.VarChar(20)
  direction      String     @db.VarChar(3)
  quantity       Decimal    @db.Decimal(12, 3)
  reference_type String?    @db.VarChar(30)
  reference_id   String?    @db.Uuid
  notes          String?
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime?  @updatedAt @db.Timestamp(6)
  deleted_at     DateTime?
  created_by     String?    @db.Uuid
  updated_by     String?    @db.Uuid
  deleted_by     String?    @db.Uuid
  products       products   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses     warehouses @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([product_id], map: "idx_stock_movements_product")
  @@index([reference_type, reference_id], map: "idx_stock_movements_ref")
  @@index([warehouse_id], map: "idx_stock_movements_warehouse")
  @@schema("tenant")
}

model warehouses {
  id                                               String                      @id @default(uuid()) @db.Uuid
  location_id                                      String?                     @db.Uuid
  unit_id                                          String?                     @db.Uuid
  name                                             String                      @db.VarChar(255)
  code                                             String?                     @unique @db.VarChar(50)
  active                                           Boolean                     @default(true)
  is_virtual                                       Boolean                     @default(false)
  created_at                                       DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                                       DateTime?                   @updatedAt @db.Timestamp(6)
  deleted_at                                       DateTime?
  created_by                                       String?                     @db.Uuid
  updated_by                                       String?                     @db.Uuid
  deleted_by                                       String?                     @db.Uuid
  pallets                                          pallets[]
  picking_orders                                   picking_orders[]
  trips_trips_destination_warehouse_idTowarehouses trips[]                     @relation("trips_destination_warehouse_idTowarehouses")
  trips_trips_origin_warehouse_idTowarehouses      trips[]                     @relation("trips_origin_warehouse_idTowarehouses")
  warehouse_stock                                  warehouse_stock[]
  stock_reservations                               stock_reservations[]
  warehouse_stock_movements                        warehouse_stock_movements[]
  documents                                        documents[]                 @relation("DocumentWarehouse")
  document_items                                   document_items[]            @relation("DocumentItemWarehouse")
  maintenance_parts                                maintenance_parts[]
  current_tires                                    tires[]
  locations                                        locations?                  @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units                                            units?                      @relation(fields: [unit_id], references: [id])

  @@schema("tenant")
}

model currencies {
  id                   String                   @id @default(uuid()) @db.Uuid
  code                 String                   @unique @db.VarChar(10)
  name                 String                   @db.VarChar(100)
  symbol               String                   @db.VarChar(10)
  is_base              Boolean                  @default(false)
  active               Boolean                  @default(true)
  created_at           DateTime                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                @updatedAt @db.Timestamp(6)
  deleted_at           DateTime?
  created_by           String?                  @db.Uuid
  updated_by           String?                  @db.Uuid
  deleted_by           String?                  @db.Uuid
  rates_from           currency_rates[]         @relation("rate_from")
  rates_to             currency_rates[]         @relation("rate_to")
  product_prices       product_price[]
  productCosts         product_costs[]
  productVariantPrices product_variant_prices[]
  productVariantCosts  product_variant_costs[]

  @@schema("tenant")
}

model currency_rates {
  id               String           @id @default(uuid()) @db.Uuid
  from_currency_id String           @db.Uuid
  to_currency_id   String           @db.Uuid
  rate             Decimal          @db.Decimal(18, 6)
  source           String?
  effective_date   DateTime
  rate_type        CurrencyRateType @default(OFFICIAL)
  active           Boolean          @default(true)
  created_at       DateTime         @default(now())
  updated_at       DateTime?        @updatedAt
  deleted_at       DateTime?
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid
  deleted_by       String?          @db.Uuid
  from_currency    currencies       @relation("rate_from", fields: [from_currency_id], references: [id])
  to_currency      currencies       @relation("rate_to", fields: [to_currency_id], references: [id])

  @@unique([from_currency_id, to_currency_id, effective_date, rate_type])
  @@index([effective_date])
  @@schema("tenant")
}
